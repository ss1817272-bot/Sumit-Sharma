onst percent \u003d ((this.currentIndex + 1) / questions.length) * 100;\n        document.getElementById(\u0027game-progress\u0027).style.width \u003d `${percent}%`;\n\n        document.getElementById(\u0027level-badge\u0027).innerText \u003d isHi \n          ? `प्रश्न ${this.currentIndex + 1} / ${questions.length}` \n          : `Question ${this.currentIndex + 1} of ${questions.length}`;\n\n        document.getElementById(\u0027q-art\u0027).innerText \u003d q.art || \u0027⭐\u0027;\n        document.getElementById(\u0027q-text\u0027).innerText \u003d isHi ? q.q_hi : q.q_en;\n\n        // Hide feedback banner\n        const fbCard \u003d document.getElementById(\u0027feedback-card\u0027);\n        fbCard.className \u003d \u0027feedback-banner\u0027;\n\n        // Toggle UI modes\n        const optGrid \u003d document.getElementById(\u0027options-container\u0027);\n        const scrambleBox \u003d document.getElementById(\u0027scramble-container\u0027);\n        const memoryGrid \u003d document.getElementById(\u0027memory-container\u0027);\n\n        optGrid.style.display \u003d \u0027none\u0027;\n        scrambleBox.style.display \u003d \u0027none\u0027;\n        memoryGrid.style.display \u003d \u0027none\u0027;\n\n        if (q.type \u003d\u003d\u003d \u0027mcq\u0027) {\n          optGrid.style.display \u003d \u0027grid\u0027;\n          this.renderMCQ(q);\n        } else if (q.type \u003d\u003d\u003d \u0027scramble\u0027) {\n          scrambleBox.style.display \u003d \u0027flex\u0027;\n          this.renderScramble(q);\n        } else if (q.type \u003d\u003d\u003d \u0027memory\u0027) {\n          memoryGrid.style.display \u003d \u0027grid\u0027;\n          this.renderMemory(q);\n        }\n\n        this.speakMascot(isHi ? \u0027ध्यान से सोचो और सही जवाब चुनो!\u0027 : \u0027Think carefully and choose the right answer!\u0027);\n      },\n\n      renderMCQ(q) {\n        const container \u003d document.getElementById(\u0027options-container\u0027);\n        container.innerHTML \u003d \u0027\u0027;\n        const isHi \u003d this.lang \u003d\u003d\u003d \u0027hi\u0027;\n        const opts \u003d isHi ? q.opts_hi : q.opts_en;\n\n        opts.forEach((optText, index) \u003d\u003e {\n          const btn \u003d document.createElement(\u0027button\u0027);\n          btn.className \u003d \u0027opt-btn\u0027;\n          btn.innerText \u003d optText;\n          btn.onclick \u003d () \u003d\u003e this.handleMCQChoice(btn, index, q.ans, q);\n          container.appendChild(btn);\n        });\n      },\n\n      handleMCQChoice(selectedBtn, selectedIndex, correctIndex, q) {\n        const isHi \u003d this.lang \u003d\u003d\u003d \u0027hi\u0027;\n        const buttons \u003d document.querySelectorAll(\u0027.opt-btn\u0027);\n        buttons.forEach(b \u003d\u003e b.disabled \u003d true);\n\n        if (selectedIndex \u003d\u003d\u003d correctIndex) {\n          selectedBtn.classList.add(\u0027correct\u0027);\n          SoundFX.correct();\n          this.addRewards(10, 1);\n          this.checkBadgesOnAnswer();\n          this.showFeedback(true, isHi ? \u0027शानदार! बिल्कुल सही!\u0027 : \u0027Awesome! That\\\u0027s correct!\u0027, isHi ? q.exp_hi : q.exp_en);\n        } else {\n          selectedBtn.classList.add(\u0027wrong\u0027);\n          buttons[correctIndex].classList.add(\u0027correct\u0027);\n          SoundFX.wrong();\n          // Gentle and encouraging, never punishing\n          this.showFeedback(false, isHi ? \u0027कोई बात नहीं, नया सीखने को मिला!\u0027 : \u0027No worries! A great chance to learn!\u0027, isHi ? q.exp_hi : q.exp_en);\n        }\n      },\n\n      /* Word Scramble Mini-Game */\n      renderScramble(q) {\n        this.scrambleTarget \u003d q.word;\n        this.scrambleBuilt \u003d [];\n\n        const slots \u003d document.getElementById(\u0027word-slots\u0027);\n        const tiles \u003d document.getElementById(\u0027word-tiles\u0027);\n        slots.innerHTML \u003d \u0027\u0027;\n        tiles.innerHTML \u003d \u0027\u0027;\n\n        for (let i \u003d 0; i \u003c q.word.length; i++) {\n          const slot \u003d document.createElement(\u0027div\u0027);\n          slot.className \u003d \u0027empty-slot\u0027;\n          slot.innerText \u003d \u0027_\u0027;\n          slot.id \u003d `slot-${i}`;\n          slots.appendChild(slot);\n        }\n\n        // Shuffle letters\n        const letters \u003d q.word.split(\u0027\u0027).sort(() \u003d\u003e Math.random() - 0.5);\n        letters.forEach((char, idx) \u003d\u003e {\n          const tile \u003d document.createElement(\u0027div\u0027);\n          tile.className \u003d \u0027letter-tile\u0027;\n          tile.innerText \u003d char;\n          tile.onclick \u003d () \u003d\u003e {\n            if (this.scrambleBuilt.length \u003c q.word.length) {\n              this.scrambleBuilt.push(char);\n              tile.style.visibility \u003d \u0027hidden\u0027;\n              SoundFX.coin();\n              this.updateScrambleSlots();\n            }\n          };\n          tiles.appendChild(tile);\n        });\n      },\n\n      updateScrambleSlots() {\n        for (let i \u003d 0; i \u003c this.scrambleTarget.length; i++) {\n          const slot \u003d document.getElementById(`slot-${i}`);\n          if (this.scrambleBuilt[i]) {\n            slot.innerText \u003d this.scrambleBuilt[i];\n            slot.style.border \u003d \u00272px solid #ff9800\u0027;\n            slot.style.background \u003d \u0027#fff8e1\u0027;\n          } else {\n            slot.innerText \u003d \u0027_\u0027;\n            slot.style.border \u003d \u00272px dashed #999\u0027;\n            slot.style.background \u003d \u0027rgba(0,0,0,0.05)\u0027;\n          }\n        }\n      },\n\n      checkScrambleAnswer() {\n        const isHi \u003d this.lang \u003d\u003d\u003d \u0027hi\u0027;\n        const q \u003d QUESTION_BANK[this.currentSubject][this.currentIndex];\n        const attempt \u003d this.scrambleBuilt.join(\u0027\u0027);\n\n        if (attempt \u003d\u003d\u003d this.scrambleTarget) {\n          SoundFX.correct();\n          this.addRewards(15, 1);\n          this.showFeedback(true, isHi ? \u0027कमाल कर दिया!\u0027 : \u0027Brilliant Spelling!\u0027, isHi ? q.exp_hi : q.exp_en);\n        } else {\n          SoundFX.wrong();\n          this.showFeedback(false, isHi ? \u0027दोबारा कोशिश करें!\u0027 : \u0027Try one more time!\u0027, isHi ? \u0027अक्षरों को सही क्रम में लगाकर शब्द पूरा करें।\u0027 : \u0027Arrange the letters in the proper order.\u0027);\n          // Reset tiles\n          setTimeout(() \u003d\u003e this.renderScramble(q), 1200);\n        }\n      },\n\n      /* Memory Match Mini-Game */\n      renderMemory(q) {\n        const container \u003d document.getElementById(\u0027memory-container\u0027);\n        container.innerHTML \u003d \u0027\u0027;\n        this.memoryFlipped \u003d [];\n        this.memoryMatchedCount \u003d 0;\n\n        const deck \u003d [...q.pairs, ...q.pairs].sort(() \u003d\u003e Math.random() - 0.5);\n        deck.forEach((symbol, i) \u003d\u003e {\n          const card \u003d document.createElement(\u0027div\u0027);\n          card.className \u003d \u0027memory-card\u0027;\n          card.innerText \u003d \u0027❓\u0027;\n          card.dataset.symbol \u003d symbol;\n          card.onclick \u003d () \u003d\u003e this.handleMemoryClick(card);\n          container.appendChild(card);\n        });\n      },\n\n      handleMemoryClick(card) {\n        if (card.classList.contains(\u0027flipped\u0027) || card.classList.contains(\u0027matched\u0027) || this.memoryFlipped.length \u003d\u003d\u003d 2) {\n          return;\n        }\n\n        card.classList.add(\u0027flipped\u0027);\n        card.innerText \u003d card.dataset.symbol;\n        SoundFX.coin();\n        this.memoryFlipped.push(card);\n\n        if (this.memoryFlipped.length \u003d\u003d\u003d 2) {\n          const [c1, c2] \u003d this.memoryFlipped;\n          if (c1.dataset.symbol \u003d\u003d\u003d c2.dataset.symbol) {\n            c1.classList.add(\u0027matched\u0027);\n            c2.classList.add(\u0027matched\u0027);\n            this.memoryFlipped \u003d [];\n            this.memoryMatchedCount++;\n            SoundFX.correct();\n\n            const q \u003d QUESTION_BANK[this.currentSubject][this.currentIndex];\n            if (this.memoryMatchedCount \u003d\u003d\u003d q.pairs.length) {\n              this.addRewards(20, 2);\n              this.showFeedback(true, this.lang \u003d\u003d\u003d \u0027hi\u0027 ? \u0027स्मृति चैंपियन!\u0027 : \u0027Memory Champion!\u0027, this.lang \u003d\u003d\u003d \u0027hi\u0027 ? q.exp_hi : q.exp_en);\n            }\n          } else {\n            SoundFX.wrong();\n            setTimeout(() \u003d\u003e {\n              c1.classList.remove(\u0027flipped\u0027);\n              c2.classList.remove(\u0027flipped\u0027);\n              c1.innerText \u003d \u0027❓\u0027;\n              c2.innerText \u003d \u0027❓\u0027;\n              this.memoryFlipped \u003d [];\n            }, 800);\n          }\n        }\n      },\n\n      showFeedback(isSuccess, title, explanation) {\n        const banner \u003d document.getElementById(\u0027feedback-card\u0027);\n        banner.className \u003d `feedback-banner show ${isSuccess ? \u0027feedback-success\u0027 : \u0027feedback-retry\u0027}`;\n        document.getElementById(\u0027fb-title\u0027).innerText \u003d title;\n        document.getElementById(\u0027fb-explanation\u0027).innerText \u003d explanation;\n        document.getElementById(\u0027fb-next-btn\u0027).innerText \u003d this.lang \u003d\u003d\u003d \u0027hi\u0027 ? \u0027आगे बढ़ें ➡\u0027 : \u0027Next ➡\u0027;\n        this.speakMascot(title);\n      },\n\n      nextQuestion() {\n        this.currentIndex++;\n        this.renderQuestion();\n      },\n\n      addRewards(coinsEarned, starsEarned) {\n        this.coins +\u003d coinsEarned;\n        this.stars +\u003d starsEarned;\n        this.updateHeaderStats();\n        this.saveStorage();\n      },\n\n      updateHeaderStats() {\n        document.getElementById(\u0027coin-count\u0027).innerText \u003d this.coins;\n        document.getElementById(\u0027star-count\u0027).innerText \u003d this.stars;\n      },\n\n      showCelebration() {\n        SoundFX.fanfare();\n        this.triggerConfetti();\n        this.navigate(\u0027celebrate\u0027);\n        this.unlockBadge(\u0027super_scout\u0027);\n\n        const isHi \u003d this.lang \u003d\u003d\u003d \u0027hi\u0027;\n        document.getElementById(\u0027win-title\u0027).innerText \u003d isHi ? \u0027अद्भुत सफर पूरा हुआ!\u0027 : \u0027Magical World Conquered!\u0027;\n        document.getElementById(\u0027win-subtext\u0027).innerText \u003d isHi \n          ? `आपने ${this.currentSubject.toUpperCase()} के सभी प्रश्नों को सफलतापूर्वक हल किया!` \n          : `You mastered all challenges in ${this.currentSubject.toUpperCase()}!`;\n        document.getElementById(\u0027win-next-btn\u0027).innerText \u003d isHi ? \u0027नया लोक चुनें\u0027 : \u0027Choose Next World\u0027;\n\n        this.speakMascot(isHi ? \u0027वाह! आप तो सचमुच ज्ञान के जादूगर हैं!\u0027 : \u0027Wow! You are a true Knowledge Wizard!\u0027);\n      },\n\n      checkBadgesOnAnswer() {\n        this.unlockBadge(\u0027first_step\u0027);\n        if (this.currentSubject \u003d\u003d\u003d \u0027math\u0027) this.unlockBadge(\u0027math_wiz\u0027);\n        if (this.currentSubject \u003d\u003d\u003d \u0027science\u0027) this.unlockBadge(\u0027science_star\u0027);\n        if (this.currentSubject \u003d\u003d\u003d \u0027english\u0027 || this.currentSubject \u003d\u003d\u003d \u0027hindi\u0027) this.unlockBadge(\u0027word_master\u0027);\n      },\n\n      unlockBadge(badgeId) {\n        if (!this.unlockedBadges.includes(badgeId)) {\n          this.unlockedBadges.push(badgeId);\n          this.saveStorage();\n          this.renderBadgesPreview();\n          const bObj \u003d BADGES.find(b \u003d\u003e b.id \u003d\u003d\u003d badgeId);\n          if (bObj) {\n            const name \u003d this.lang \u003d\u003d\u003d \u0027hi\u0027 ? bObj.name_hi : bObj.name_en;\n            this.speakMascot(`🎉 नया बैज प्राप्त हुआ: ${name}!`);\n          }\n        }\n      },\n\n      renderBadgesPreview() {\n        const previewContainer \u003d document.getElementById(\u0027home-badge-preview\u0027);\n        previewContainer.innerHTML \u003d \u0027\u0027;\n        BADGES.slice(0, 4).forEach(b \u003d\u003e {\n          const isUnlocked \u003d this.unlockedBadges.includes(b.id);\n          const badgeDiv \u003d document.createElement(\u0027div\u0027);\n          badgeDiv.className \u003d `badge-item ${isUnlocked ? \u0027unlocked\u0027 : \u0027\u0027}`;\n          badgeDiv.innerHTML \u003d `\n            \u003cdiv class\u003d\"badge-icon\"\u003e${b.icon}\u003c/div\u003e\n            \u003cdiv class\u003d\"badge-name\"\u003e${this.lang \u003d\u003d\u003d \u0027hi\u0027 ? b.name_hi : b.name_en}\u003c/div\u003e\n          `;\n          previewContainer.appendChild(badgeDiv);\n        });\n      },\n\n      openAllBadgesModal() {\n        const container \u003d document.getElementById(\u0027all-badges-container\u0027);\n        container.innerHTML \u003d \u0027\u0027;\n        BADGES.forEach(b \u003d\u003e {\n          const isUnlocked \u003d this.unlockedBadges.includes(b.id);\n          const badgeDiv \u003d document.createElement(\u0027div\u0027);\n          badgeDiv.className \u003d `badge-item ${isUnlocked ? \u0027unlocked\u0027 : \u0027\u0027}`;\n          badgeDiv.innerHTML \u003d `\n            \u003cdiv class\u003d\"badge-icon\"\u003e${b.icon}\u003c/div\u003e\n            \u003cdiv class\u003d\"badge-name\"\u003e${this.lang \u003d\u003d\u003d \u0027hi\u0027 ? b.name_hi : b.name_en}\u003c/div\u003e\n            \u003cdiv style\u003d\"font-size:0.65rem; color:#888;\"\u003e${b.desc}\u003c/div\u003e\n          `;\n          container.appendChild(badgeDiv);\n        });\n        document.getElementById(\u0027badge-modal\u0027).classList.add(\u0027open\u0027);\n      },\n\n      /* PARENT GATE FOR SAFETY \u0026 SETTINGS */\n      openParentModal() {\n        // Generate a simple math problem that 5-year olds won\u0027t randomly bypass\n        const n1 \u003d Math.floor(Math.random() * 8) + 6;\n        const n2 \u003d Math.floor(Math.random() * 8) + 5;\n        this.gateAnswer \u003d n1 + n2;\n        document.getElementById(\u0027gate-question\u0027).innerText \u003d `${n1} + ${n2} \u003d ?`;\n        document.getElementById(\u0027gate-input\u0027).value \u003d \u0027\u0027;\n        document.getElementById(\u0027gate-section\u0027).style.display \u003d \u0027block\u0027;\n        document.getElementById(\u0027settings-area\u0027).style.display \u003d \u0027none\u0027;\n        document.getElementById(\u0027parent-modal\u0027).classList.add(\u0027open\u0027);\n      },\n\n      verifyParentGate() {\n        const val \u003d parseInt(document.getElementById(\u0027gate-input\u0027).value, 10);\n        if (val \u003d\u003d\u003d this.gateAnswer) {\n          SoundFX.correct();\n          document.getElementById(\u0027gate-section\u0027).style.display \u003d \u0027none\u0027;\n          document.getElementById(\u0027settings-area\u0027).style.display \u003d \u0027block\u0027;\n        } else {\n          SoundFX.wrong();\n          alert(this.lang \u003d\u003d\u003d \u0027hi\u0027 ? \u0027गलत उत्तर! केवल माता-पिता ही इसे खोल सकते हैं।\u0027 : \u0027Incorrect! Parent verification failed.\u0027);\n        }\n      },\n\n      closeParentModal() {\n        document.getElementById(\u0027parent-modal\u0027).classList.remove(\u0027open\u0027);\n      },\n\n      changeDifficulty(level) {\n        this.difficulty \u003d level;\n        this.saveStorage();\n        SoundFX.coin();\n      },\n\n      resetProgress() {\n        if (confirm(this.lang \u003d\u003d\u003d \u0027hi\u0027 ? \u0027क्या आप सचमुच सारा स्कोर और बैज रीसेट करना चाहते हैं?\u0027 : \u0027Are you sure you want to reset all game progress