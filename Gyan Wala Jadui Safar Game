e\n        \u003cbr/\u003e\n        \u003cinput type\u003d\"number\" id\u003d\"gate-input\" placeholder\u003d\"?\" /\u003e\n        \u003cbutton class\u003d\"big-btn\" style\u003d\"padding: 6px 16px; font-size: 0.9rem; margin-top: 5px;\" onclick\u003d\"GameApp.verifyParentGate()\"\u003eप्रवेश करें\u003c/button\u003e\n      \u003c/div\u003e\n\n      \u003c!-- Settings Protected Area --\u003e\n      \u003cdiv id\u003d\"settings-area\" style\u003d\"display: none;\"\u003e\n        \u003ch4 style\u003d\"margin: 10px 0 5px;\" id\u003d\"lbl-diff\"\u003eकठिनाई स्तर (Difficulty)\u003c/h4\u003e\n        \u003cselect id\u003d\"diff-select\" style\u003d\"width: 100%; padding: 8px; border-radius: 8px; font-size: 1rem; margin-bottom: 15px;\" onchange\u003d\"GameApp.changeDifficulty(this.value)\"\u003e\n          \u003coption value\u003d\"easy\"\u003eखोजकर्ता (Explorer: 5-7 वर्ष)\u003c/option\u003e\n          \u003coption value\u003d\"medium\"\u003eसाहसी (Adventurer: 8-10 वर्ष)\u003c/option\u003e\n          \u003coption value\u003d\"hard\"\u003eविजेता (Champion: 11-12 वर्ष)\u003c/option\u003e\n        \u003c/select\u003e\n\n        \u003ch4 style\u003d\"margin: 10px 0 5px;\" id\u003d\"lbl-audio-speed\"\u003eध्वनि प्रभाव (Sound Effects)\u003c/h4\u003e\n        \u003cbutton class\u003d\"big-btn\" style\u003d\"background:#2196f3; padding: 8px 16px; font-size: 0.95rem; width: 100%;\" onclick\u003d\"SoundFX.toggle()\"\u003e\n          🔊 ध्वनि चालू / बंद टॉगल करें\n        \u003c/button\u003e\n\n        \u003ch4 style\u003d\"margin: 20px 0 5px; color: #d32f2f;\" id\u003d\"lbl-reset-head\"\u003eप्रगति रीसेट करें (Reset Progress)\u003c/h4\u003e\n        \u003cp style\u003d\"font-size: 0.8rem; color: #777;\" id\u003d\"lbl-reset-sub\"\u003eयह सिक्के, सितारे और बैज शून्य कर देगा।\u003c/p\u003e\n        \u003cbutton class\u003d\"big-btn\" style\u003d\"background: #e53935; padding: 8px 16px; font-size: 0.95rem; width: 100%;\" onclick\u003d\"GameApp.resetProgress()\"\u003e\n          🗑️ सभी प्रगति हटाएं\n        \u003c/button\u003e\n      \u003c/div\u003e\n\n    \u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003c!-- ALL BADGES MODAL --\u003e\n  \u003cdiv class\u003d\"modal-overlay\" id\u003d\"badge-modal\"\u003e\n    \u003cdiv class\u003d\"modal-card\"\u003e\n      \u003cbutton class\u003d\"modal-close\" onclick\u003d\"document.getElementById(\u0027badge-modal\u0027).classList.remove(\u0027open\u0027)\"\u003e✕\u003c/button\u003e\n      \u003ch2 style\u003d\"margin-bottom: 15px; color: #ff9800;\"\u003e🏆 आपके जादुई बैज (Badges)\u003c/h2\u003e\n      \u003cdiv class\u003d\"badge-grid\" id\u003d\"all-badges-container\"\u003e\u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003cscript\u003e\n    /* \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n       AUDIO SYNTHESIZER (Web Audio API - 100% Standalone, Zero Broken Links)\n       \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d */\n    const SoundFX \u003d {\n      ctx: null,\n      enabled: true,\n\n      init() {\n        if (!this.ctx) {\n          const AudioContext \u003d window.AudioContext || window.webkitAudioContext;\n          if (AudioContext) {\n            this.ctx \u003d new AudioContext();\n          }\n        }\n      },\n\n      playTone(freq, type \u003d \u0027sine\u0027, duration \u003d 0.15, delay \u003d 0) {\n        if (!this.enabled) return;\n        this.init();\n        if (!this.ctx) return;\n\n        setTimeout(() \u003d\u003e {\n          try {\n            const osc \u003d this.ctx.createOscillator();\n            const gain \u003d this.ctx.createGain();\n            osc.type \u003d type;\n            osc.frequency.setValueAtTime(freq, this.ctx.currentTime);\n            gain.gain.setValueAtTime(0.15, this.ctx.currentTime);\n            gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n\n            osc.connect(gain);\n            gain.connect(this.ctx.destination);\n\n            osc.start();\n            osc.stop(this.ctx.currentTime + duration);\n          } catch(e) {}\n        }, delay * 1000);\n      },\n\n      correct() {\n        // Cheerful ascending major triad\n        this.playTone(523.25, \u0027triangle\u0027, 0.15, 0.0); // C5\n        this.playTone(659.25, \u0027triangle\u0027, 0.15, 0.1); // E5\n        this.playTone(783.99, \u0027triangle\u0027, 0.25, 0.2); // G5\n      },\n\n      wrong() {\n        // Gentle warm boop (never harsh or punishing)\n        this.playTone(280, \u0027sine\u0027, 0.2, 0);\n        this.playTone(240, \u0027sine\u0027, 0.25, 0.15);\n      },\n\n      coin() {\n        // High-pitched coin ping\n        this.playTone(987.77, \u0027sine\u0027, 0.1, 0);\n        this.playTone(1318.51, \u0027sine\u0027, 0.2, 0.08);\n      },\n\n      fanfare() {\n        // Level win victory melody\n        [523.25, 659.25, 783.99, 1046.5].forEach((freq, i) \u003d\u003e {\n          this.playTone(freq, \u0027triangle\u0027, 0.25, i * 0.12);\n        });\n      },\n\n      toggle() {\n        this.enabled \u003d !this.enabled;\n        document.getElementById(\u0027sound-toggle-btn\u0027).innerText \u003d this.enabled ? \u0027🔊\u0027 : \u0027🔇\u0027;\n        return this.enabled;\n      }\n    };\n\n    /* \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n       QUESTION BANK (Bilingual: Hindi \u0026 English across 5 Subjects \u0026 3 Tiers)\n       \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d */\n    const QUESTION_BANK \u003d {\n      math: [\n        {\n          type: \u0027mcq\u0027,\n          art: \u0027🍎🍎 + 🍎\u0027,\n          q_hi: \u00272 सेब और 1 सेब मिलकर कितने सेब होते हैं?\u0027,\n          q_en: \u0027How many apples are 2 apples and 1 apple together?\u0027,\n          opts_hi: [\u00272\u0027, \u00273\u0027, \u00274\u0027, \u00275\u0027],\n          opts_en: [\u00272\u0027, \u00273\u0027, \u00274\u0027, \u00275\u0027],\n          ans: 1,\n          exp_hi: \u00272 + 1 \u003d 3 होता है! बहुत बढ़िया गणना!\u0027,\n          exp_en: \u00272 + 1 \u003d 3! Excellent counting!\u0027\n        },\n        {\n          type: \u0027mcq\u0027,\n          art: \u0027🔺 🔲 ⚪\u0027,\n          q_hi: \u0027एक त्रिभुज (Triangle) में कितनी भुजाएँ (Sides) होती हैं?\u0027,\n          q_en: \u0027How many sides does a triangle have?\u0027,\n          opts_hi: [\u00273\u0027, \u00274\u0027, \u00275\u0027, \u00270\u0027],\n          opts_en: [\u00273\u0027, \u00274\u0027, \u00275\u0027, \u00270\u0027],\n      